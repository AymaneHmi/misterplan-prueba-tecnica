{% extends "base.html.twig" %}

{% block title %}Reservas{% endblock %}
{% block content %}

<h1>Reservas</h1>

<button id="createReservationBtn">Crear una reserva</button>

<form method="post" id="createReservationForm" class="hidden">

    <div>
        <label>Nombre Huesped</label>
        <input type="text" name="nombreHuesped" required placeholder="Nombre Huésped">
    </div>
    <div>
        <label>Email Huesped</label>
        <input type="email" name="emailHuesped" required placeholder="Email Huésped">
    </div>
    <div>
        <label>Nombre alojamiento</label>
        <input type="text" name="nombreAlojamiento" required placeholder="Nombre Alojamiento">
    </div>
    <div>
        <label>Fecha entrada</label>
        <input type="date" name="fechaEntrada" required>
    </div>
    <div>
        <label>Fecha salida</label>
        <input type="date" name="fechaSalida" required>
    </div>
    <div>
        <label>Importe</label>
        <input type="number" name="importe" required placeholder="Importe">
    </div>
    <div>
        <label>Notas</label>
        <input type="text" name="notas" placeholder="Notas">
    </div>

    <div class="form-actions">
        <button type="button" id="cancelReservationFormBtn">cancelar</button>
        <button type="submit" id="createReservationFromBtn">Crear</button>
    </div>

    <div id="formStatusMessage" class="status-message hidden"></div>

</form>

<div class="filter-panel">
    <div class="filter-group">
        <label for="stateFilter">Estado:</label>
        <select id="stateFilter">
            <option value=""></option>
            <option value="pendiente">Pendiente</option>
            <option value="confirmada">Confirmada</option>
            <option value="cancelada">Cancelada</option>
        </select>
    </div>
    
    <div class="filter-group">
        <label for="startDateFilter">Desde:</label>
        <input type="date" id="startDateFilter">
    </div>
    
    <div class="filter-group">
        <label for="endDateFilter">Hasta:</label>
        <input type="date" id="endDateFilter">
    </div>
    
    <div class="filter-group">
        <label for="guestNameFilter">Huésped:</label>
        <input type="text" id="guestNameFilter" placeholder="Nombre Huésped">
    </div>
    
    <button id="filterBtn">Filtrar</button>
</div>


<!-- Table viewport architecture for mobile responsiveness -->
<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>id</th>
                <th>nombre huesped</th>
                <th>email huesped</th>
                <th>nombre alojamiento</th>
                <th>fecha entrada</th>
                <th>fecha salida</th>
                <th>estado</th>
                <th>importe</th>
                <th>notas</th>
                <th>fecha creacion</th>
                <th>acciones</th>
            </tr>
        </thead>
        <tbody id="reservations_table">
        </tbody>
    </table>
</div>

<div id="reservationsStatusMessage" class="status-message hidden"></div>

{% endblock %}