{% extends "base.html.twig" %}

{% block title %}Reservas{% endblock %}
{% block content %}

<h1>Reservas</h1>

<div id="loading-indicator" class="hidden">cargando reservas..</div>
<div id="error-indicator" class="hidden">error cargando reservas..</div>

<button id="createReservationBtn">Crear una reserva</button>

<!-- Form layout with modular wrappers -->
<form method="post" id="createReservationForm" class="hidden">
    <div>
        <label>Nombre Huesped</label>
        <input type="text" name="nombreHuesped" required>
    </div>
    <div>
        <label>Email Huesped</label>
        <input type="email" name="emailHuesped" required>
    </div>
    <div>
        <label>Nombre alojamiento</label>
        <input type="text" name="nombreAlojamiento" required>
    </div>
    <div>
        <label>Fecha entrada</label>
        <input type="date" name="fechaEntrada" required>
    </div>
    <div>
        <label>Fecha salida</label>
        <input type="date" name="fechaSalida" required>
    </div>
    <div>
        <label>Importe</label>
        <input type="number" name="importe" required>
    </div>
    <div>
        <label>Notas</label>
        <input type="text" name="notas">
    </div>

    <div class="form-actions">
        <button type="button" id="cancelReservationFormBtn">cancelar</button>
        <button type="submit" id="createReservationFromBtn">Crear</button>
    </div>
</form>

<!-- Filter view section wrapped neatly -->
<div class="filter-panel">
    <div class="filter-group">
        <label for="stateFilter">Estado:</label>
        <select id="stateFilter">
            <option value=""></option>
            <option value="pendiente">pendiente</option>
            <option value="confirmada">confirmada</option>
            <option value="cancelada">cancelada</option>
        </select>
    </div>
    
    <div class="filter-group">
        <label for="startDateFilter">Desde:</label>
        <input type="date" id="startDateFilter">
    </div>
    
    <div class="filter-group">
        <label for="endDateFilter">Hasta:</label>
        <input type="date" id="endDateFilter">
    </div>
    
    <div class="filter-group">
        <label for="guestNameFilter">Huésped:</label>
        <input type="text" id="guestNameFilter">
    </div>
    
    <button id="filterBtn">Filtrar</button>
</div>

<!-- Table viewport architecture for mobile responsiveness -->
<div class="table-container">
    <table>
        <thead>
            <tr>
                <th>id</th>
                <th>nombre huesped</th>
                <th>email huesped</th>
                <th>nombre alojamiento</th>
                <th>fecha entrada</th>
                <th>fecha salida</th>
                <th>estado</th>
                <th>importe</th>
                <th>notas</th>
                <th>fecha creacion</th>
                <th>acciones</th>
            </tr>
        </thead>
        <tbody id="reservations_table">
        </tbody>
    </table>
</div>

<div id="empty-indicator" class="hidden">no reservas..</div>

{% endblock %}